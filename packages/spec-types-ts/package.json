{
  "name": "@heatcompass/heat-engine-spec",
  "version": "0.1.0",
  "description": "TypeScript types + fixture loaders for the heat-engine-spec contract.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "sync-fixtures": "node -e \"const fs=require('fs');for (const f of ['wet-bulb.fixtures.csv','flag-mapping.fixtures.csv','refuge-break.fixtures.csv']) fs.copyFileSync('../../spec/tier1-foundation/'+f,'./fixtures/'+f);\"",
    "build": "npm run sync-fixtures && tsc",
    "pretest": "npm run sync-fixtures",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "csv-parse": "^5.5.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HeatCompass/heat-engine-spec.git",
    "directory": "packages/spec-types-ts"
  },
  "license": "MIT"
}
